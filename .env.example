# Copy to .env.local for local development. Never commit real values.
# Configure production and preview values in the Netlify UI or CLI.

MONGO_URI=
JWT_SECRET=
INTERNAL_KEY=

# Google OAuth Web client ID (full value from Google Cloud Console, e.g. 123456789-xxxx.apps.googleusercontent.com).
# Required on Netlify: NEXT_PUBLIC_GOOGLE_CLIENT_ID only (server uses the same via lib/google-auth.js).
# Optional locally: GOOGLE_CLIENT_ID and/or OAUTH_CLIENT (same value); do not set those on Netlify when NEXT_PUBLIC_* is set.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# OAUTH_CLIENT=

# Optional production cookie domain, e.g. .example.com (omit for localhost)
COOKIE_DOMAIN=

# Browser Google Sign-In (@react-oauth/google). NEXT_PUBLIC_* is inlined at build time — after changing it, run `npm run build` before `npm run start`, or restart `next dev`.

# Google Cloud Console (Web client): Authorized JavaScript origins must include http://localhost:3000 and your deployed site origin (no path).
