# Copy to .env.local for local development. Never commit real values.
# Configure production and preview values in the Netlify UI or CLI.

MONGO_URI=
JWT_SECRET=
INTERNAL_KEY=
# Google OAuth client ID for server-side credential verification (GOOGLE_CLIENT_ID is also accepted in code).
OAUTH_CLIENT=
# Optional production cookie domain, e.g. .example.com
COOKIE_DOMAIN=
