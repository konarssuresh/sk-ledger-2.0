# Copy to .env.local for local development. Never commit real values.
# Configure production and preview values in the Netlify UI or CLI.

MONGO_URI=
JWT_SECRET=
INTERNAL_KEY=
# Google OAuth Web client ID (full value from Google Cloud Console, e.g. 123456789-xxxx.apps.googleusercontent.com).
# OAUTH_CLIENT and NEXT_PUBLIC_GOOGLE_CLIENT_ID must match. GOOGLE_CLIENT_ID is also accepted for server verification.
OAUTH_CLIENT=
# Optional production cookie domain, e.g. .example.com (omit for localhost)
COOKIE_DOMAIN=

# Browser Google Sign-In (@react-oauth/google). Inlined at build time — after changing this, run `npm run build` before `npm run start`, or restart `next dev`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Cloud Console (Web client): Authorized JavaScript origins must include http://localhost:3000 and your deployed site origin (no path).
